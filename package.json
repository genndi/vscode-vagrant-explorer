{
  "name": "vagrant-explorer",
  "displayName": "Vagrant Explorer: VMs & Network Topology",
  "description": "%extension.description%",
  "version": "0.6.1",
  "publisher": "genndi",
  "author": "Gustavo Enndi",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1322",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genndi/vscode-vagrant-explorer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vagrant",
    "virtualbox",
    "vm",
    "devops",
    "network",
    "topology",
    "vagrantfile"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/Vagrantfile"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vagrantManager",
          "title": "Vagrant",
          "icon": "media/vagrant.svg"
        }
      ]
    },
    "views": {
      "vagrantManager": [
        {
          "id": "vagrantManager.machines",
          "name": "%view.machines%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vagrantManager.machines",
        "contents": "%view.welcome%"
      }
    ],
    "commands": [
      {
        "command": "vagrantManager.refresh",
        "title": "%command.refresh%",
        "category": "Vagrant",
        "icon": "$(refresh)"
      },
      {
        "command": "vagrantManager.up",
        "title": "%command.up%",
        "category": "Vagrant",
        "icon": "$(play)"
      },
      {
        "command": "vagrantManager.halt",
        "title": "%command.halt%",
        "category": "Vagrant",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vagrantManager.reload",
        "title": "%command.reload%",
        "category": "Vagrant",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vagrantManager.provision",
        "title": "%command.provision%",
        "category": "Vagrant",
        "icon": "$(tools)"
      },
      {
        "command": "vagrantManager.suspend",
        "title": "%command.suspend%",
        "category": "Vagrant",
        "icon": "$(debug-pause)"
      },
      {
        "command": "vagrantManager.resume",
        "title": "%command.resume%",
        "category": "Vagrant",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vagrantManager.destroy",
        "title": "%command.destroy%",
        "category": "Vagrant",
        "icon": "$(trash)"
      },
      {
        "command": "vagrantManager.ssh",
        "title": "%command.ssh%",
        "category": "Vagrant",
        "icon": "$(terminal)"
      },
      {
        "command": "vagrantManager.openVagrantfile",
        "title": "%command.openVagrantfile%",
        "category": "Vagrant",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vagrantManager.openTerminal",
        "title": "%command.openTerminal%",
        "category": "Vagrant",
        "icon": "$(terminal)"
      },
      {
        "command": "vagrantManager.showOutput",
        "title": "%command.showOutput%",
        "category": "Vagrant",
        "icon": "$(output)"
      },
      {
        "command": "vagrantManager.copyText",
        "title": "%command.copyText%",
        "category": "Vagrant",
        "icon": "$(copy)"
      },
      {
        "command": "vagrantManager.showDetails",
        "title": "%command.showDetails%",
        "category": "Vagrant",
        "icon": "$(info)"
      },
      {
        "command": "vagrantManager.showTopology",
        "title": "%command.showTopology%",
        "category": "Vagrant",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vagrantManager.refresh",
          "when": "view == vagrantManager.machines",
          "group": "navigation"
        },
        {
          "command": "vagrantManager.showTopology",
          "when": "view == vagrantManager.machines",
          "group": "navigation"
        },
        {
          "command": "vagrantManager.showOutput",
          "when": "view == vagrantManager.machines",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vagrantManager.showDetails",
          "when": "view == vagrantManager.machines && viewItem =~ /^machine\\./",
          "group": "0_info@1"
        },
        {
          "command": "vagrantManager.up",
          "when": "view == vagrantManager.machines && viewItem =~ /^machine\\.(?!running)/",
          "group": "inline@1"
        },
        {
          "command": "vagrantManager.ssh",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "inline@1"
        },
        {
          "command": "vagrantManager.halt",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "inline@2"
        },
        {
          "command": "vagrantManager.up",
          "when": "view == vagrantManager.machines && viewItem =~ /^machine\\.(?!running)/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "vagrantManager.resume",
          "when": "view == vagrantManager.machines && viewItem == machine.saved",
          "group": "1_lifecycle@2"
        },
        {
          "command": "vagrantManager.halt",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "1_lifecycle@3"
        },
        {
          "command": "vagrantManager.reload",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "1_lifecycle@4"
        },
        {
          "command": "vagrantManager.suspend",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "1_lifecycle@5"
        },
        {
          "command": "vagrantManager.provision",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "2_ops@1"
        },
        {
          "command": "vagrantManager.ssh",
          "when": "view == vagrantManager.machines && viewItem == machine.running",
          "group": "2_ops@2"
        },
        {
          "command": "vagrantManager.destroy",
          "when": "view == vagrantManager.machines && viewItem =~ /^machine\\.(?!not_created)/",
          "group": "9_danger@1"
        },
        {
          "command": "vagrantManager.up",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "vagrantManager.halt",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "vagrantManager.up",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "1_lifecycle@1"
        },
        {
          "command": "vagrantManager.halt",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "1_lifecycle@2"
        },
        {
          "command": "vagrantManager.reload",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "1_lifecycle@3"
        },
        {
          "command": "vagrantManager.provision",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "2_ops@1"
        },
        {
          "command": "vagrantManager.showTopology",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "3_nav@0"
        },
        {
          "command": "vagrantManager.openVagrantfile",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "3_nav@1"
        },
        {
          "command": "vagrantManager.openTerminal",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "3_nav@2"
        },
        {
          "command": "vagrantManager.destroy",
          "when": "view == vagrantManager.machines && viewItem == project",
          "group": "9_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vagrantManager.up",
          "when": "false"
        },
        {
          "command": "vagrantManager.halt",
          "when": "false"
        },
        {
          "command": "vagrantManager.reload",
          "when": "false"
        },
        {
          "command": "vagrantManager.provision",
          "when": "false"
        },
        {
          "command": "vagrantManager.suspend",
          "when": "false"
        },
        {
          "command": "vagrantManager.resume",
          "when": "false"
        },
        {
          "command": "vagrantManager.destroy",
          "when": "false"
        },
        {
          "command": "vagrantManager.ssh",
          "when": "false"
        },
        {
          "command": "vagrantManager.openVagrantfile",
          "when": "false"
        },
        {
          "command": "vagrantManager.openTerminal",
          "when": "false"
        },
        {
          "command": "vagrantManager.copyText",
          "when": "false"
        },
        {
          "command": "vagrantManager.showDetails",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Vagrant Explorer",
      "properties": {
        "vagrantManager.vagrantPath": {
          "type": "string",
          "default": "vagrant",
          "description": "%config.vagrantPath%"
        },
        "vagrantManager.vboxManagePath": {
          "type": "string",
          "default": "VBoxManage",
          "description": "%config.vboxManagePath%"
        },
        "vagrantManager.showGlobalMachines": {
          "type": "boolean",
          "default": true,
          "description": "%config.showGlobalMachines%"
        },
        "vagrantManager.pruneGlobalStatus": {
          "type": "boolean",
          "default": false,
          "description": "%config.pruneGlobalStatus%"
        },
        "vagrantManager.autoRefreshInterval": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.autoRefreshInterval%"
        },
        "vagrantManager.topology.readVagrantfile": {
          "type": "boolean",
          "default": true,
          "description": "%config.topology.readVagrantfile%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npx -y -p node@22 -p @vscode/vsce@3 -- vsce package",
    "l10n:export": "npx -y -p node@22 -p @vscode/l10n-dev@0.0.35 -- vscode-l10n-dev export -o ./l10n ./src"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "l10n": "./l10n"
}
